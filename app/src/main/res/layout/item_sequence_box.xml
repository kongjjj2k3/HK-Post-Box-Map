<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="5dp"
    app:cardBackgroundColor="#242424"
    app:cardCornerRadius="10dp"
    app:cardElevation="2dp"
    app:strokeColor="#383838"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <!-- Order Number Badge -->
        <TextView
            android:id="@+id/tv_sequence_num"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_count_banner"
            android:gravity="center"
            android:textColor="#FFD54F"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="1" />

        <!-- Box Name & Address -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_seq_box_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#F0F0F0"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="編號 5 郵箱" />

            <TextView
                android:id="@+id/tv_seq_box_address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#CCCCCC"
                android:textSize="12sp"
                tools:text="港鐵何文田站B2出口外/忠孝街" />
        </LinearLayout>

        <!-- Up / Down Action Buttons -->
        <ImageButton
            android:id="@+id/btn_move_up"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Move up"
            android:src="@android:drawable/arrow_up_float"
            app:tint="#64B5F6" />

        <ImageButton
            android:id="@+id/btn_move_down"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Move down"
            android:src="@android:drawable/arrow_down_float"
            app:tint="#64B5F6" />

        <!-- Remove Button -->
        <ImageButton
            android:id="@+id/btn_remove_seq"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Remove item"
            android:src="@android:drawable/ic_menu_delete"
            app:tint="#FF5252" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
