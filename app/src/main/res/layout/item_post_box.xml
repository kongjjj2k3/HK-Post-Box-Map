<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="#242424"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:strokeColor="#383838"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="10dp"
                android:contentDescription="Postbox icon"
                android:src="@drawable/ic_postbox" />

            <TextView
                android:id="@+id/tv_item_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#F0F0F0"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="編號 5 郵箱" />

            <TextView
                android:id="@+id/tv_item_district"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_district_tag"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textColor="#FF8A80"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="九龍城區" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_item_address"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#CCCCCC"
            android:textSize="14sp"
            tools:text="港鐵何文田站B2出口外/忠孝街" />

        <TextView
            android:id="@+id/tv_item_collection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#A0A0A0"
            android:textSize="12sp"
            tools:text="截郵時間: 星期一至五: 下午 2:30" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
