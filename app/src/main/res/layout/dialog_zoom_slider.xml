<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#242424"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Title Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_zoom_dialog_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="調整地圖縮放 Zoom Level"
            android:textColor="#F0F0F0"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_zoom_value_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFD54F"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="13.0" />
    </LinearLayout>

    <!-- Zoom Level Slider -->
    <com.google.android.material.slider.Slider
        android:id="@+id/slider_zoom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:stepSize="0.5"
        android:valueFrom="10.0"
        android:valueTo="20.0"
        app:thumbColor="#FF5252"
        app:trackColorActive="#FF5252"
        app:trackColorInactive="#505050" />

</LinearLayout>
