<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="#242424"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:strokeColor="#383838"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="Track icon"
                android:src="@drawable/ic_track_history"
                app:tint="#64B5F6" />

            <TextView
                android:id="@+id/tv_track_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#F0F0F0"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="軌跡 2026-10-14 14:30" />

            <ImageButton
                android:id="@+id/btn_delete_track"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Delete track"
                android:src="@android:drawable/ic_menu_delete"
                app:tint="#FF5252" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_track_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#B0B0B0"
            android:textSize="12sp"
            tools:text="開始時間: 2026-10-14 14:30:22" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_track_distance"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#81C784"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="距離: 1.25 km" />

            <TextView
                android:id="@+id/tv_track_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFD54F"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="時間: 15分 30秒" />
        </LinearLayout>

        <!-- Show on Map Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_show_on_map"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="10dp"
            android:text="在地圖上顯示軌跡"
            android:textColor="#64B5F6"
            android:textSize="13sp"
            app:cornerRadius="8dp"
            app:strokeColor="#64B5F6" />

        <!-- Export as GPX Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_export_gpx"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="6dp"
            android:text="另存為 .gpx 檔案"
            android:textColor="#FFD54F"
            android:textSize="13sp"
            app:cornerRadius="8dp"
            app:icon="@android:drawable/ic_menu_save"
            app:iconGravity="textStart"
            app:iconPadding="6dp"
            app:iconTint="#FFD54F"
            app:strokeColor="#FFD54F" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
