<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="#505050" />

    <!-- Title & District Badge Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_post_box_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#F0F0F0"
            android:textSize="20sp"
            android:textStyle="bold"
            tools:text="編號 5 郵箱" />

        <TextView
            android:id="@+id/tv_district_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_district_tag"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:textColor="#FF8A80"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="九龍城區" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="12dp"
        android:background="#333333" />

    <!-- Address Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:gravity="top|start"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="10dp"
            android:contentDescription="Address icon"
            android:src="@android:drawable/ic_menu_myplaces"
            app:tint="#FF5252" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/lbl_address"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="位置"
                android:textColor="#B0B0B0"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#F0F0F0"
                android:textSize="15sp"
                tools:text="港鐵何文田站B2出口外/忠孝街" />
        </LinearLayout>
    </LinearLayout>

    <!-- Collection Time Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:gravity="top|start"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="10dp"
            android:contentDescription="Collection time icon"
            android:src="@android:drawable/ic_menu_recent_history"
            app:tint="#64B5F6" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/lbl_collection_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="截郵時間"
                android:textColor="#B0B0B0"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_collection_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#F0F0F0"
                android:textSize="15sp"
                tools:text="星期一至五: 下午 2:30" />
        </LinearLayout>
    </LinearLayout>

    <!-- SubDistrict / Coordinates -->
    <LinearLayout
        android:id="@+id/layout_extra_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:gravity="top|start"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="10dp"
            android:contentDescription="Info icon"
            android:src="@android:drawable/ic_menu_info_details"
            app:tint="#81C784" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/lbl_extra_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="分區與經緯度"
                android:textColor="#B0B0B0"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_subdistrict_coords"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#CCCCCC"
                android:textSize="13sp"
                tools:text="紅磡 (22.30933, 114.18206)" />
        </LinearLayout>
    </LinearLayout>

    <!-- Edit Box Info Button (Only shown when Edit Mode is active) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_edit_post_box"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="10dp"
        android:text="編輯郵箱資訊"
        android:textColor="#FFD54F"
        android:textSize="14sp"
        android:visibility="gone"
        app:cornerRadius="12dp"
        app:icon="@android:drawable/ic_menu_edit"
        app:iconGravity="textStart"
        app:iconPadding="8dp"
        app:iconTint="#FFD54F"
        app:strokeColor="#FFD54F" />

    <!-- Add to Planned Route Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_add_to_route"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="10dp"
        android:text="加入預定路徑順序"
        android:textColor="#FFB300"
        android:textSize="14sp"
        app:cornerRadius="12dp"
        app:icon="@drawable/ic_route_plan"
        app:iconGravity="textStart"
        app:iconPadding="8dp"
        app:strokeColor="#FFB300" />

    <!-- Navigation Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_navigate"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:backgroundTint="#D32F2F"
        android:text="在 Google 地圖中開啟導航"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        app:cornerRadius="12dp"
        app:icon="@drawable/ic_directions"
        app:iconGravity="textStart"
        app:iconPadding="8dp" />

</LinearLayout>
